# Copy this file to .env and fill in your values.
# After editing .env, run `npm run config` (or `npm run dev`) to regenerate js/config.js.

# Base URL for the Noroff v2 API (keep the trailing slash).
API_BASE_URL=https://v2.api.noroff.dev/

# Noroff API key (https://docs.noroff.dev/docs/v2/auth/api-key).
# Not required for login/register; used for authenticated requests.
API_KEY=

# Credentials used by the Playwright login tests.
TEST_EMAIL=
TEST_PASSWORD=
